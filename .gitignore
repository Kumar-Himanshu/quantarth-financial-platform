# Gradle & Build Artifacts
.gradle/
build/
bin/
out/
target/
*/build/
*/bin/
*/out/
*/target/
.gradletasknamecache

# Java Class & Archive Files
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Explicitly track Gradle Wrapper binaries & configuration (must be after *.jar)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!**/gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.properties

