# =============================================================================
# QuantArth Financial Intelligence Platform (FIP) - Environment Variables
# Safe defaults and placeholders for local reproducible execution
# Copy this file to '.env' before running docker compose
# =============================================================================

# PostgreSQL Master Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_secret_123
POSTGRES_PORT=5432

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest_local_secret_123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Security & Identity
JWT_SECRET=quantarth_platform_super_secure_jwt_signing_key_mvp_2026_test_string_64bytes
JWT_EXPIRATION_MS=86400000
GATEWAY_ACTIVE_KEY_ID=v1
GATEWAY_INTERNAL_SECRET=quantarth-fip-internal-mesh-secret-2026-min32chars

# Public Exposed Host Ports
# NOTE: Downstream microservices (auth, plugins, events, ai) are kept private on internal Docker network.
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana Dashboard Admin Password
GF_SECURITY_ADMIN_PASSWORD=grafana_local_secret_123
